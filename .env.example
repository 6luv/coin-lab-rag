# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 git 에 올리지 않는다. (NF2003)

# SSAFY GMS (OpenAI 호환) — 키는 https://gms.ssafy.io/web/ 에서 발급
GMS_KEY=
# 비워 두면 GMS 안내의 주소(https://gms.ssafy.io/gmsapi/api.openai.com/v1)를 쓴다 (config/settings.json)
OPENAI_BASE_URL=
# 비워 두면 settings.json 의 모델 (chat: gpt-4.1-mini, embedding: text-embedding-3-small)
CHAT_MODEL=
EMBEDDING_MODEL=

# CoinGecko Demo API 키 (무료, https://www.coingecko.com/en/api/pricing 에서 발급)
# 비워 두면 키 없는 공개 호출 → 공용 IP 에서는 429 가 잦다.
COINGECKO_DEMO_API_KEY=

# 위키미디어 User-Agent 정책용 연락처 (이메일 또는 프로젝트 URL)
CONTACT_EMAIL=

# openai | fake  (fake: API 키 없이 흐름만 점검)
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai

# 실험용 덮어쓰기 (비워 두면 config/settings.json 값 사용)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=6
# SEARCH_TYPE=similarity
