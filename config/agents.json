{
  "implementer": {
    "name": "Claude",
    "cmd": ["claude", "-p", "--model", "opus", "--effort", "medium", "--permission-mode", "acceptEdits",
            "--allowedTools", "Read", "Edit", "Write", "Glob", "Grep",
            "Bash(python -m pytest:*)", "Bash(python -m scripts.check_sample:*)", "Bash(git status:*)", "Bash(git diff:*)"]
  },
  "reviewer": {
    "name": "Codex",
    "cmd": ["codex", "exec", "--sandbox", "read-only", "-c", "model_reasoning_effort=\"medium\"",
            "--output-last-message", "{out}", "-"]
  },
  "max_fix_rounds": 3,
  "timeout_sec": 1800,
  "tests": [
    ["{python}", "-m", "pytest", "-q", "-p", "no:cacheprovider"],
    ["{python}", "-m", "scripts.check_sample"]
  ],
  "reviews_dir": "docs/reviews"
}
