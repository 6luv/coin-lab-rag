{
  "domain": {
    "name": "코인 프로젝트 분석",
    "risky_domain": true,
    "disclaimer": "이 서비스의 답변은 수집된 문서를 요약한 정보이며 투자 조언이 아닙니다. 가상자산은 가격 변동과 원금 손실 위험이 크므로 투자 판단은 본인 책임하에 전문가 상담을 거쳐 결정하세요."
  },
  "coins": {
    "vs_currency": "usd",
    "count": 150,
    "min_items": 100
  },
  "chunk": {
    "size": 1000,
    "overlap": 200
  },
  "retrieval": {
    "top_k": 6,
    "search_type": "similarity",
    "mmr_fetch_k": 30,
    "mmr_lambda": 0.5,
    "recommend_candidates": 20
  },
  "collections": {
    "items": "coin_meta",
    "docs": "coin_docs"
  },
  "paths": {
    "coins_raw": "data/raw/coingecko_raw.json",
    "coins": "data/coins.json",
    "source_map": "data/source_map.json",
    "docs_dir": "data/docs",
    "manifest": "data/docs/manifest.json",
    "chroma_dir": "data/chroma"
  },
  "http": {
    "user_agent": "CoinRAG-SSAFY/0.1 (education project; contact: {contact})",
    "timeout_sec": 20,
    "max_retries": 4,
    "coingecko_interval_sec": 6.5,
    "coingecko_interval_with_key_sec": 2.0,
    "coingecko_429_wait_sec": 65,
    "wiki_interval_sec": 0.5,
    "whitepaper_interval_sec": 1.0,
    "whitepaper_max_wait_sec": 30,
    "whitepaper_timeout_sec": 20
  },
  "models": {
    "base_url": "https://gms.ssafy.io/gmsapi/api.openai.com/v1",
    "use_responses_api": true,
    "embedding": "text-embedding-3-small",
    "chat": "gpt-4.1-mini",
    "temperature": 0.2
  },
  "collect": {
    "max_keywords": 4,
    "candidates_per_keyword": 5,
    "max_new_docs": 3,
    "min_doc_chars": 300,
    "whitepaper_max_mb": 20,
    "whitepaper_max_pages": 60,
    "whitepaper_max_chars": 80000,
    "whitepaper_min_chars": 500
  }
}
